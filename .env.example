# ── Telegram ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Supabase ───────────────────────────────────────────────
SUPABASE_URL=
# Use the SERVICE ROLE key (server-side only, never ship to a client)
SUPABASE_SERVICE_KEY=

# ── Admins (REQUIRED for admin panel + payment confirmations) ──
# Comma-separated Telegram numeric user IDs that get admin powers
ADMIN_TELEGRAM_IDS=

# ── Crypto (payments) ──────────────────────────────────────
# Preferred: account xpub/zpub (BIP84 native segwit). Yields a unique address
# per order + automatic on-chain confirmation (no fees, self-custodial, no node).
# Deposits/wallet top-ups REQUIRE an xpub (no per-deposit address without it).
BTC_XPUB=
LTC_XPUB=
# Fallback only (used if the matching xpub is empty): single static address,
# confirmed manually by an admin.
BTC_ADDRESS=
LTC_ADDRESS=
# Optional tunables (have sensible defaults):
QUOTE_TTL_MINUTES=15            # how long a quoted rate/address stays valid
PAYMENT_TOLERANCE=0.995         # accept payments ≥ this fraction of the quote
CRYPTO_HTTP_TIMEOUT_MS=8000     # timeout for price feed + block explorers

# ── Pricing (cents) ────────────────────────────────────────
# NOTE: service fee + Uber rates are also admin-editable at runtime (DB settings),
# which override these env defaults when set.
LEGO_UNIT_PRICE_CENTS=1000      # $10 each
LEGO_BUNDLE_QTY=6               # 6 for ...
LEGO_BUNDLE_PRICE_CENTS=4500    # ... $45
SERVICE_FEE_CENTS=5000          # $50 base on-site build-help fee

# ── Delivery / travel surcharge ────────────────────────────
# Estimated as: base + per_mile * road_miles(Civic Center -> customer)
UBER_BASE_CENTS=500             # $5 base
UBER_PER_MILE_CENTS=200         # $2 / mile
UBER_FLAT_FALLBACK_CENTS=1500   # used when geocoding fails
CIVIC_CENTER_LAT=37.7793
CIVIC_CENTER_LNG=-122.4193
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODE_TIMEOUT_MS=6000
MAX_DELIVERY_MILES=30           # reject deliveries beyond this radius
CONTACT_EMAIL=ops@sfbrickco.com # used in the Nominatim User-Agent

# ── Server ─────────────────────────────────────────────────
PORT=3000

# ── Ops / hardening (all optional) ─────────────────────────
ABANDON_AFTER_HOURS=24          # auto-cancel unpaid orders/bookings older than this
SESSION_TTL_MINUTES=30          # idle in-progress flow expiry
RATE_LIMIT_MAX=20               # max messages/callbacks per window per user
RATE_LIMIT_WINDOW_MS=10000
