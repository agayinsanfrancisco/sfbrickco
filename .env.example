# ── Telegram ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Supabase ───────────────────────────────────────────────
SUPABASE_URL=
# Use the SERVICE ROLE key (server-side only, never ship to a client)
SUPABASE_SERVICE_KEY=

# ── Crypto (payments for v1) ───────────────────────────────────────
# Preferred: account xpub/zpub (BIP84 native segwit). Yields a unique address
# per order + automatic on-chain confirmation (no fees, self-custodial, no node).
BTC_XPUB=
LTC_XPUB=
# Fallback only (used if the matching xpub is empty): single static address,
# confirmed manually by an admin.
BTC_ADDRESS=
LTC_ADDRESS=

# ── Pricing (cents) ────────────────────────────────────────
LEGO_UNIT_PRICE_CENTS=1000      # $10 each
LEGO_BUNDLE_QTY=6               # 6 for ...
LEGO_BUNDLE_PRICE_CENTS=4500    # ... $45
SERVICE_FEE_CENTS=5000          # $50 base expert fee

# ── Uber surcharge estimate (option A) ─────────────────────
# Estimated as: base + per_mile * road_miles(Civic Center -> customer)
UBER_BASE_CENTS=500             # $5 base
UBER_PER_MILE_CENTS=200         # $2 / mile
CIVIC_CENTER_LAT=37.7793
CIVIC_CENTER_LNG=-122.4193
# Geocoder for option A. Leave default to use free OpenStreetMap Nominatim.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# ── Server ─────────────────────────────────────────────────
PORT=3000

# ── Admins ─────────────────────────────────────────────────
# Comma-separated Telegram numeric user IDs that get admin powers
ADMIN_TELEGRAM_IDS=

# ── Uber Direct (optional; auto-dispatch courier on order Accept) ──
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_CUSTOMER_ID=
UBER_DIRECT_PICKUP_NAME=SF Brick Company
UBER_DIRECT_PICKUP_ADDRESS=
UBER_DIRECT_PICKUP_PHONE=
